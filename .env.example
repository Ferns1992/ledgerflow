# Runtime
NODE_ENV=production
PORT=3000

# SQLite lives on a named volume, not in the image.
DB_PATH=/app/data/accounting.db

# REQUIRED in production, 32+ random bytes. It is mixed into the session token
# hash, so a stolen database alone cannot be used to forge a valid cookie.
# Losing it invalidates every active session but loses no data.
#   openssl rand -hex 32
SESSION_PEPPER=

# Set true once the app is behind HTTPS (it is, behind the Cloudflare tunnel).
# Adds the Secure cookie flag and HSTS.
SECURE_COOKIES=true

# Password of the very first admin, seeded only when the users table is empty.
# Change it before the first boot, or set it and then rotate on first login:
# the account is flagged must_change_password and will be forced to set its own.
INITIAL_ADMIN_PASSWORD=change-me-now

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Caps login attempts per username+IP before a 15 minute block.
LOGIN_MAX_ATTEMPTS=5

# Set the proxy's X-Forwarded-For as the client address so rate limiting
# actually distinguishes clients behind Cloudflare. Only enable this when the
# app is genuinely only reachable through a proxy you control, otherwise a
# client can spoof its own address and bypass the limit.
TRUST_PROXY=false
